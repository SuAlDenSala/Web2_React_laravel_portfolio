# ==============================================================================
# Git Ignore - Web 2 (Coursework & Monorepo Root)
# Covers both Next.js Frontend and Laravel Inertia Backend
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SENSITIVE DATA & CREDENTIALS
# ------------------------------------------------------------------------------
# Environment configuration & secret keys
.env
.env.*
.env.backup
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Private keys, security certificates, and authentication tokens
*.pem
*.key
*.cert
*.crt
auth.json
storage/*.key

# Databases & local data stores (contain user records, hashed passwords, sessions)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.sql
*.dump
database/database.sqlite
React_laravel/backend/database/database.sqlite

# Server & VM deployment configurations
Homestead.json
Homestead.yaml

# ------------------------------------------------------------------------------
# 2. LARGE DATA & DEPENDENCY DIRECTORIES
# ------------------------------------------------------------------------------
# Node.js dependencies
node_modules/
*/node_modules/
React_laravel/*/node_modules/

# PHP / Composer dependencies
vendor/
*/vendor/
React_laravel/backend/vendor/

# Yarn / PnP package managers
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# 3. BUILD OUTPUTS & COMPILED BUNDLES
# ------------------------------------------------------------------------------
# Next.js build cache & static export
.next/
*/.next/
React_laravel/frontend/.next/
out/
*/out/

# Vite & Laravel compiled public assets
public/build/
React_laravel/backend/public/build/
public/hot
public/storage
public/fonts-manifest.dev.json
bootstrap/ssr/

# Generic build output
build/
dist/

# ------------------------------------------------------------------------------
# 4. STORAGE, RUNTIME CACHES & LOGS
# ------------------------------------------------------------------------------
# Laravel framework storage
storage/app/private/*
!storage/app/private/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore
storage/pail/*
!storage/pail/.gitignore
storage/inertia-devtools/*
!storage/inertia-devtools/.gitignore

# Laravel bootstrap compiled cache
bootstrap/cache/*
!bootstrap/cache/.gitignore

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Wayfinder generated client routes / actions
resources/js/actions/
resources/js/routes/
resources/js/wayfinder/
React_laravel/backend/resources/js/actions/
React_laravel/backend/resources/js/routes/
React_laravel/backend/resources/js/wayfinder/

# ------------------------------------------------------------------------------
# 5. TESTING, COVERAGE & STATIC ANALYSIS
# ------------------------------------------------------------------------------
.phpunit.cache/
.phpunit.result.cache
.phpstan.cache/
coverage/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 6. OPERATING SYSTEM & IDE ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor directories
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.sublime-project
*.sublime-workspace
.phpactor.json

# Vercel deployment cache
.vercel
